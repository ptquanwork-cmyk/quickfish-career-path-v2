+class SavedCareer(BaseModel):
+    """A career bookmarked from the Career Intelligence dashboard.
+
+    The career catalogue ships as a static JSON asset on the frontend, so there
+    is no careers table to point a ForeignKey at — the slug is the identity and
+    the name is denormalised so the list stays readable without the catalogue.
+    """
+
+    user = models.ForeignKey(
+        Profile, on_delete=models.CASCADE, related_name="saved_careers"
+    )
+    career_slug = models.CharField(max_length=160)
+    career_name = models.CharField(max_length=255, blank=True, default="")
+
+    class Meta:
+        ordering = ["-created_at"]
+        constraints = [
+            models.UniqueConstraint(
+                fields=["user", "career_slug"], name="unique_saved_career"
+            )
+        ]
+
+    def __str__(self):
+        return f"{self.user_id} -> {self.career_slug}"
