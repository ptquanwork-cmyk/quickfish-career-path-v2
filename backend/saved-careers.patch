+class SavedCareerAPIView(APIView):
+    """Bookmarked careers for the Career Intelligence dashboard.
+
+    GET    -> {"slugs": [...], "items": [{slug, name, created_at}]}
+    POST   -> toggle {"career_slug": "...", "career_name": "..."}; returns {"saved": bool}
+    DELETE -> remove ?career_slug=... (idempotent)
+    """
+
+    permission_classes = [IsAuthenticated]
+
+    def get(self, request):
+        rows = SavedCareer.objects.filter(user=request.user)
+        return Response(
+            {
+                "slugs": [row.career_slug for row in rows],
+                "items": [
+                    {
+                        "career_slug": row.career_slug,
+                        "career_name": row.career_name,
+                        "created_at": row.created_at,
+                    }
+                    for row in rows
+                ],
+            }
+        )
+
+    def post(self, request):
+        raw_slug = request.data.get("career_slug")
+        slug = raw_slug.strip() if isinstance(raw_slug, str) else ""
+        name = request.data.get("career_name") or ""
+        if not slug or len(slug) > 160 or not isinstance(name, str):
+            return Response(
+                {"detail": "career_slug must be 1-160 characters; career_name must be text."},
+                status=status.HTTP_400_BAD_REQUEST,
+            )
+        row, created = SavedCareer.objects.get_or_create(
+            user=request.user,
+            career_slug=slug,
+            defaults={"career_name": name[:255]},
+        )
+        if not created:
+            row.delete()
+            return Response({"saved": False, "career_slug": slug})
+        return Response(
+            {"saved": True, "career_slug": slug}, status=status.HTTP_201_CREATED
+        )
+
+    def delete(self, request):
+        slug = (request.query_params.get("career_slug") or "").strip()
+        SavedCareer.objects.filter(user=request.user, career_slug=slug).delete()
+        return Response(status=status.HTTP_204_NO_CONTENT)
